# Server Port
PORT=3001

# GitHub Token (Optional: increases API rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=

# AI Provider Configuration
# Supported: gemini | groq | openrouter | ollama | demo
AI_PROVIDER=gemini

# Google Gemma 4 Open-Weight Model
# Target live model: gemma-4-31b-it (Google AI / Gemini API)
AI_MODEL=gemma-4-31b-it

# Google Gemini API Key
GEMINI_API_KEY=

# Local Ollama Host (if AI_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
